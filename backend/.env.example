# =============================================================================
# RAG Chatbot Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
# Qdrant Cloud URL (e.g., https://xyz.gcp.cloud.qdrant.io:6333)
QDRANT_URL=https://your-cluster.gcp.cloud.qdrant.io:6333
# Qdrant API Key (from Qdrant Cloud console)
QDRANT_API_KEY=your-qdrant-api-key-here

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
# Your OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Override default models
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Neon Postgres (Analytics)
# -----------------------------------------------------------------------------
# Neon serverless Postgres connection string
# Leave empty to skip analytics logging
NEON_DATABASE_URL=postgresql://user:password@ep-xyz-region.aws.neon.tech/neondb

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://soban-saleem.github.io

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# APP_NAME=RAG Chatbot Backend
# DEBUG=false

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
# Number of content chunks to retrieve per query (1-10)
# CHUNK_COUNT=5
# Max question length in characters
# MAX_QUESTION_LENGTH=5000
# Cache TTL in seconds (default 24 hours)
# CACHE_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per minute per session
# RATE_LIMIT_REQUESTS=60
# Rate limit window in seconds
# RATE_LIMIT_WINDOW=60
